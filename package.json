{
  "name": "@cocreate/crud",
  "version": "2.0.3",
  "description": "CoCreate CRUD client and server interfaces for unified data operations.",
  "keywords": [
    "multi-database",
    "parallel-writing",
    "distributed-database",
    "database-router",
    "multi-tenant-crud",
    "realtime-sync",
    "mongodb",
    "postgresql",
    "mysql",
    "dynamodb",
    "firestore",
    "sqlite",
    "cockroachdb",
    "mariadb",
    "oracle-db",
    "timescaledb",
    "planetscale",
    "turso",
    "ferretdb",
    "redshift"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "demo": "PORT=5000 node demo/server.js",
    "test": "node --test test/server/*.test.js test/server/*.test.cjs test/client/*.test.cjs",
    "test:server": "node --test test/server/*.test.js test/server/*.test.cjs",
    "test:client": "node --test test/client/*.test.cjs",
    "build": "webpack --mode=production --config webpack.client.config.js",
    "dev": "webpack --config webpack.client.config.js --watch"
  },
  "type": "module",
  "main": "./src/server/index.js",
  "browser": "./src/client/index.js",
  "exports": {
    ".": {
      "node": "./src/server/index.js",
      "browser": "./src/client/index.js",
      "default": "./src/server/index.js"
    },
    "./server": "./src/server/index.js",
    "./client": "./src/client/index.js"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/CoCreateJS/crud.git"
  },
  "author": "CoCreate LLC",
  "license": "AGPL-3.0",
  "bugs": {
    "url": "https://github.com/CoCreateJS/crud/issues"
  },
  "homepage": "https://CoCreateJS.com/docs/crud",
  "dependencies": {
    "@cocreate/config": "^2.0.0",
    "@cocreate/utils": "^2.0.0",
    "@cocreate/indexeddb": "^2.0.0",
    "@cocreate/socket": "^2.0.1"
  },
  "devDependencies": {
    "@cocreate/webpack": "^2.0.0"
  }
}

{
  "name": "@cocreate/crud-server",
  "version": "1.43.0",
  "description": "High-performance, multi-tenant server-side CRUD orchestration engine supporting parallel multi-database writing, real-time sync, and tenant-isolated data routing across 20+ database engines.",
  "keywords": [
    "multi-database",
    "parallel-writing",
    "distributed-database",
    "database-router",
    "multi-tenant-crud",
    "realtime-sync",
    "mongodb",
    "postgresql",
    "mysql",
    "dynamodb",
    "firestore",
    "sqlite",
    "cockroachdb",
    "mariadb",
    "oracle-db",
    "timescaledb",
    "planetscale",
    "turso",
    "ferretdb",
    "redshift"
  ],
  "publishConfig": {
    "access": "public"
  },
  "cocreate": {
    "environment": [
      "server"
    ],
    "interface": {
      "schemaVersion": 1,
      "summary": "High-performance, multi-tenant server-side CRUD orchestration engine supporting parallel multi-database writing, real-time sync, and tenant-isolated data routing across 20+ database engines.",
      "source": "src/index.js",
      "api": {
        "exports": [
          "config",
          "drivers",
          "getDriver",
          "getFilterCount",
          "getStorage",
          "init",
          "loadCrudConfig",
          "registerDriver",
          "send"
        ]
      }
    }
  },
  "scripts": {
    "demo": "PORT=5000 node demo/server.js",
    "test": "echo \"Error: no test specified\" && exit 1"
  },
  "type": "module",
  "main": "./src/index.js",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cocreatejs/CoCreate-crud-server.git"
  },
  "author": "CoCreate LLC",
  "license": "AGPL-3.0",
  "bugs": {
    "url": "https://github.com/CoCreate-app/CoCreate-crud-server/issues"
  },
  "homepage": "https://cocreate.app/docs/CoCreate-crud-server",
  "dependencies": {
    "@cocreate/config": "^1.21.0",
    "@cocreate/utils": "^1.54.0"
  }
}
